{
  "buildCommand": "node tools/indexnow.mjs sitemap.xml . --lastmod && rm tools/indexnow.mjs",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Content-Type",
          "value": "application/x-apple-diskimage"
        }
      ]
    },
    {
      "source": "/appcast.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {"source": "/analytics-consent.gif", "has": [{"type": "query", "key": "choice", "value": "granted"}], "headers": [{"key": "Set-Cookie", "value": "analytics_consent=granted; Path=/; Max-Age=34560000; Secure; SameSite=Lax"}, {"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/analytics-consent.gif", "has": [{"type": "query", "key": "choice", "value": "denied"}], "headers": [{"key": "Set-Cookie", "value": "analytics_consent=denied; Path=/; Max-Age=34560000; Secure; SameSite=Lax"}, {"key": "Cache-Control", "value": "no-store"}]}
  ],
  "redirects": [
    {
      "source": "/downloads",
      "destination": "/download/",
      "permanent": false
    },
    {
      "source": "/downloads/",
      "destination": "/download/",
      "permanent": false
    }
  ]
}
